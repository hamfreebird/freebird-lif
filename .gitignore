.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 派生数据：由 scripts/fetch_data.py 生成，不入库
data/*
!data/.gitkeep

# 基准输出与图表。调优网格的原始 json 可由脚本重建，不入库；
# 但 M3 的逐 seed 结果与逐样本预测是统计结论的唯一证据，必须入库。
benchmarks/*.csv
benchmarks/*.json
!benchmarks/train_shd_m3.json
!benchmarks/m3_summary.json
!benchmarks/train_shd_m3b.json
!benchmarks/train_shd_m4b.json
!benchmarks/train_shd_final_w.json
!benchmarks/train_shd_h0.json
!benchmarks/train_shd_h0ff.json
!benchmarks/train_shd_h0ffs.json
!benchmarks/rnn_diag.json
!benchmarks/train_shd_m2tau.json
!benchmarks/train_shd_m2ei.json
!benchmarks/train_shd_rqb.json
!benchmarks/rqb_coupling.json
!benchmarks/train_shd_rqb_tau5.json
!benchmarks/bench_nmnist_*.json
!benchmarks/v4cal_*.json
!benchmarks/bench_evtouch_*.json




# 训练产物（检查点由 scripts/export.py 导出到 models/ 后入库）
runs/

# pip 的临时目录：M0 装 torch 时用过 `--cache-dir .piptmp/cache`，
# 结果 166 个缓存文件（1.38 GB）被误提交。2026-11-19 重写历史剔除，
# 此处永久忽略。
.piptmp/

# 大检查点不入库：1.7 MB × 2 可由脚本重训复现，权重不是结论。
# 只保留 v1 的小产物（freebird-lif-T4.pt/.npz，各 160 KB），它们被
# tests/test_engine.py 与 docs/README-v1.md 直接引用。
models/shd-*.pt

# 工作区记忆（agent 本地笔记，不入库）
.workbuddy/

# SHD 原始数据与分箱缓存（可由 scripts/fetch_shd.py 重建）
data/shd/
