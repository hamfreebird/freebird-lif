.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 派生数据：由 scripts/fetch_data.py 生成，不入库
data/*
!data/.gitkeep

# 基准输出与图表。调优网格的原始 json 可由脚本重建，不入库；
# 但 M3 的逐 seed 结果与逐样本预测是统计结论的唯一证据，必须入库。
benchmarks/*.csv
benchmarks/*.json
!benchmarks/train_shd_m3.json
!benchmarks/m3_summary.json
!benchmarks/train_shd_m3b.json
!benchmarks/train_shd_m4b.json
!benchmarks/train_shd_final_w.json

# 训练产物（检查点由 scripts/export.py 导出到 models/ 后入库）
runs/

# 工作区记忆（agent 本地笔记，不入库）
.workbuddy/

# SHD 原始数据与分箱缓存（可由 scripts/fetch_shd.py 重建）
data/shd/
